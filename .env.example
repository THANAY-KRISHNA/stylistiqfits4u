# =============================================
# STYL IS TIQ — Environment Variables Reference
# Copy this to .env for local development.
# All VITE_* variables are embedded in the browser bundle at build time.
# Never put secret/service-role keys in VITE_* variables.
# =============================================

# ---------------------
# SUPABASE (required)
# ---------------------
# Your Supabase project URL (safe to include — it's a public endpoint)
VITE_SUPABASE_URL=https://lmgrhnwksuztcsmwkoqo.supabase.co

# Supabase anon/public key
# Get from: Supabase Dashboard → Project Settings → API → Project API Keys → anon public
# This key is safe to expose in the browser — RLS policies protect your data.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ---------------------
# ADMIN (optional override)
# ---------------------
# The email address that is allowed to access the admin dashboard.
# Must match an account created in Supabase Auth.
VITE_ADMIN_EMAIL=stylistiqfits4u@gmail.com

# ---------------------
# GEMINI API (optional — AI features)
# ---------------------
# For AI-powered product descriptions (future feature).
# Never expose your Gemini API key in client code for production.
GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------
# APP (informational)
# ---------------------
APP_URL=http://localhost:3000

# =============================================
# VERCEL ENVIRONMENT VARIABLES
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# Do NOT commit .env to git (it's in .gitignore)
# =============================================
# VITE_SUPABASE_URL       → same value as above
# VITE_SUPABASE_ANON_KEY  → same value as above
# VITE_ADMIN_EMAIL        → stylistiqfits4u@gmail.com
